{
  "name": "chronosleep",
  "version": "1.0.0",
  "private": true,
  "description": "ChronoSleep — calculadora de social jetlag y planner semanal. Bienestar educativo, no diagnóstico.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vectors": "vitest run tests/unit/vectors.test.ts",
    "test:e2e": "playwright test",
    "lighthouse:ci": "lhci autorun",
    "drive:verify": "tsx scripts/drive-verify.ts",
    "drive:sync": "tsx scripts/drive-sync.ts",
    "check:all": "npm run lint && npm run typecheck && npm test && npm run test:vectors && npm run drive:verify"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "posthog-js": "^1.438.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.0",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
