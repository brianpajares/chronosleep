# ChronoSleep — ejemplo de entorno. Nunca commitear valores reales.
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChronoSleep
MONETIZATION_MODE=validation
OWNER_EMAIL=owner@example.test
ADMIN_EMAILS=admin@example.test

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# 32 bytes aleatorios codificados en base64; usar para AES-256-GCM de payloads sensibles.
DATA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

# Google Drive — service account con acceso solo a /Apps/chronosleep/
GOOGLE_DRIVE_FOLDER_ID=REPLACE_ME
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Email / Resend
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=ChronoSleep <reports@example.test>

# Analytics / observabilidad
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME@example.ingest.sentry.io/PROJECT
SENTRY_AUTH_TOKEN=REPLACE_ME
SENTRY_ORG=REPLACE_ME
SENTRY_PROJECT=chronosleep

# Bot protection / rate limit
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# Stripe — solo se usan cuando MONETIZATION_MODE=stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_USD=price_REPLACE_ME
STRIPE_LIVE_APPROVED=false
# Solo "true" tras aprobacion explicita del owner; sin el, una clave sk_live_ es rechazada (503 payments_live_blocked).

# Google Analytics 4 (Consent Mode v2: no carga sin consentimiento)
NEXT_PUBLIC_GA_ID=G-REPLACE_ME
# Measurement Protocol (evento purchase server-side). Secreto: nunca NEXT_PUBLIC.
GA_API_SECRET=REPLACE_ME

# Datos legales visibles en politicas (si faltan se muestra [COMPLETAR]; no inventar)
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_RUC=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Lanzamiento / operacion
# false = noindex, robots y sitemap cerrados. Cambiar a true solo tras el gate de lanzamiento.
NEXT_PUBLIC_INDEXING_ENABLED=false
# Autoriza los cron de Vercel (Authorization: Bearer). Generar un valor aleatorio largo.
CRON_SECRET=REPLACE_ME
RETENTION_CALCULATION_DAYS=30
RETENTION_LEAD_DAYS=90
# Solo para E2E/dev. NO definir en produccion.
# ADMIN_TEST_LOGIN_SECRET=
